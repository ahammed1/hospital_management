PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_REAL_CLUSTER.mongodb.net/medicore?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173

ADMIN_NAME=MediCore Administrator
ADMIN_EMAIL=admin@medicore.local
ADMIN_PASSWORD=ChangeThisDemoPassword123!

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MediCore <no-reply@example.com>
